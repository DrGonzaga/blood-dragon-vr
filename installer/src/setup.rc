#include <winver.h>
#include "resource.h"
1 24 "setup.manifest"
IDI_SETUP ICON "../build/icon.ico"
IDR_MODDLL     RCDATA "../build/payload/version.dll"
IDR_DEFAULTINI RCDATA "../build/payload/fc3vr.ini"
IDR_TIPS       RCDATA "tips.txt"
IDR_CONTROLSPDF RCDATA "../build/payload/controls.pdf"
IDR_PICINDEX   RCDATA "../build/payload/pictures.txt"
IDR_PROMPTS    RCDATA "../build/payload/bdvr-prompts.txt"
#include "../build/pictures.rc"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Blood Dragon VR Setup"
      VALUE "ProductName", "Blood Dragon VR"
      VALUE "ProductVersion", BDVR_BUILD
      VALUE "OriginalFilename", "BloodDragonVR-Setup.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
